// Optional publishing configuration.
// Supply an explicit --outdir when running Nextflow.
// Only selected final results and QC reports are copied.

params.publish_outputs_enabled = true

process {

    withName: 'FASTQC' {
        publishDir = [
            path: "${params.outdir}/qc/fastqc",
            mode: 'copy',
            pattern: '*_fastqc.*',
            overwrite: false
        ]
    }

    withName: 'MARK_DUPLICATES' {
        publishDir = [
            path: "${params.outdir}/qc/duplicates",
            mode: 'copy',
            pattern: '*.markdup.metrics.txt',
            overwrite: false
        ]
    }

    withName: 'COLLECT_HS_METRICS' {
        publishDir = [
            path: "${params.outdir}/qc/coverage",
            mode: 'copy',
            pattern: '*.txt',
            overwrite: false
        ]
    }

    withName: 'COMBINE_PASS_VARIANTS' {
        publishDir = [
            path: "${params.outdir}/variants",
            mode: 'copy',
            pattern: '*.vcf.gz*',
            overwrite: false
        ]
    }
}
