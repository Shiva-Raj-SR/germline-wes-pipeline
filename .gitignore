# ========================================
# Germline WES Pipeline - Git ignore rules
# ========================================

# Raw sequencing data
data/raw/
*.fastq
*.fastq.gz
*.fq
*.fq.gz

# Alignment files
*.bam
*.bai
*.cram
*.crai
*.sam

# Reference genome files
*.fa
*.fasta
*.fna

# Large compressed variant files
*.vcf.gz
*.bcf

# Index files
*.tbi
*.csi

# Temporary files
*.tmp
*.temp

# Log files
*.log

# OS/editor files
.DS_Store

# Reference indexes and dictionaries
*.fai
*.dict
*.amb
*.ann
*.bwt
*.pac
*.sa
*.alt

# Known-sites genomic resources
resources/known_sites/*.vcf
resources/known_sites/*.idx

# Exome capture resources
resources/intervals/*.bb
resources/intervals/*.bed
resources/intervals/*.interval_list

# GIAB benchmark resources
resources/giab/*.vcf.gz
resources/giab/*.tbi
resources/giab/*.bed
resources/giab/*.txt
resources/giab/*.md
*~
