# ========================================
# Germline WES Pipeline - Git ignore rules
# ========================================

# Raw sequencing data
data/raw/
*.fastq
*.fastq.gz
*.fq
*.fq.gz

# Alignment files
*.bam
*.bai
*.cram
*.crai
*.sam

# Reference genome files
*.fa
*.fasta
*.fna

# Large compressed variant files
*.vcf.gz
*.bcf

# Index files
*.tbi
*.csi

# Temporary files
*.tmp
*.temp

# Log files
*.log

# Nextflow execution metadata
/.nextflow/
/.nextflow.log*


# OS/editor files
.DS_Store

# Reference indexes and dictionaries
*.fai
*.dict
*.amb
*.ann
*.bwt
*.pac
*.sa
*.alt

# Known-sites genomic resources
resources/known_sites/*.vcf
resources/known_sites/*.idx

# Exome capture resources
resources/intervals/*.bb
resources/intervals/*.bed
resources/intervals/*.interval_list

# GIAB benchmark resources
resources/giab/*.vcf.gz
resources/giab/*.tbi
resources/giab/*.bed
resources/giab/*.txt
resources/giab/*.md

# Raw QC generated files
results/qc/fastqc/*.zip
results/qc/fastqc/*.html
results/qc/multiqc/multiqc_data/

# Large detailed QC outputs
results/qc/wes/*.per_target_coverage.txt

# RTG derived reference
resources/rtg/*.sdf/

# Runtime process/progress files
*.pid
results/benchmark/**/done
results/benchmark/**/progress
*~

# VEP annotation: large outputs and regenerable intermediates
/results/annotation/vep/
/results/annotation/test/
/results/annotation/summary/HG002.vep.*.tsv
/results/annotation/summary/HG002.genotypes.tsv
/results/annotation/summary/HG002.high_impact.tsv
/results/annotation/summary/HG002.rtg_*_alleles.tsv
/results/annotation/summary/HG002.shortlist30.keys.tsv
/results/annotation/summary/HG002.shortlist30_GIAB.tsv
/results/annotation/summary/HG002.clinvar_PLPath.tsv
/results/annotation/summary/HG002.clinvar_pathogenic.tsv
